generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Unit {
  CM
  IN
}

enum FitPreference {
  SLIM
  REGULAR
  RELAXED
  OVERSIZED
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  DEPRECATED
  NEEDS_HUMAN_VERIFICATION // extracted automatically but something needs a person (meaning, unit, warnings). Not used for recommendations.
  INVALID                  // rejected by validation or by an admin. Never used.
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AuthEventType {
  REGISTER
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGIN_BLOCKED_DISABLED
  LOGOUT
  LOGOUT_ALL
  SESSION_REVOKED
  EMAIL_VERIFICATION_SENT
  EMAIL_VERIFIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  PASSWORD_REHASHED
  ACCOUNT_DELETED
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum SourceType {
  OFFICIAL_SITE
  OFFICIAL_PDF
  OFFICIAL_PRODUCT_PAGE
  MARKETPLACE_LISTING
  STORE_MEASURED
  MANUAL_ENTRY
  DEMO
}

enum ResearchStatus {
  SUCCESS
  PARTIAL_SUCCESS
  SOURCE_UNAVAILABLE
  ACCESS_RESTRICTED
  INVALID_DATA
  NEEDS_HUMAN_VERIFICATION
}

enum JobState {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum VerificationAction {
  APPROVED
  REJECTED
  FLAGGED
  EDITED
  DEPRECATED
}

enum FitOutcome {
  TOO_TIGHT
  PERFECT
  TOO_LOOSE
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  emailVerifiedAt   DateTime?
  passwordChangedAt DateTime?
  lastLoginAt       DateTime?
  disabledAt        DateTime? // set by an admin; the account cannot sign in while set
  sessions      Session[]
  authTokens    AuthToken[]
  authEvents    AuthEvent[]
  adminActions  AdminAuditLog[]
  verifiedVersions BrandSizeChartVersion[] @relation("VersionVerifiedBy")
  profile       UserProfile?
  measurement   BodyMeasurement?
  recommendations Recommendation[]
  savedBrands   SavedBrand[]
  feedback      UserFitFeedback[]
  verifications DataVerification[]
  researchJobs  ResearchJob[]
}

model UserProfile {
  id            String         @id @default(cuid())
  userId        String         @unique
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fitCategory   String?
  preferredUnit Unit           @default(CM)
  fitPreference FitPreference  @default(REGULAR)
  updatedAt     DateTime       @updatedAt
}

// All measurements stored in centimetres (cm) and kilograms. Unit conversion happens at the edges.
model BodyMeasurement {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  heightCm   Float?
  weightKg   Float?
  chestCm    Float?
  waistCm    Float?
  hipsCm     Float?
  shoulderCm Float?
  armLengthCm Float?
  inseamCm   Float?
  neckCm     Float?
  thighCm    Float?
  updatedAt  DateTime @updatedAt
}

model Brand {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  region     String   // INTERNATIONAL | INDIAN
  isDemo     Boolean  @default(false)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  sizeCharts BrandSizeChart[]
  savedBy    SavedBrand[]
  coverageNotes BrandCoverageNote[]
  products   Product[]
}

model ClothingCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  // Which body dimensions matter for this category (JSON array of keys, e.g. ["chest","shoulder","waist"])
  dimensions Json
  sizeCharts BrandSizeChart[]
  products   Product[]
}

model BrandSizeChart {
  id           String   @id @default(cuid())
  brandId      String
  brand        Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  categoryId   String
  category     ClothingCategory @relation(fields: [categoryId], references: [id])
  productId    String?  // null = brand-level chart; set = product-specific chart (overrides the brand chart when verified)
  product      Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  productKey   String   @default("") // productId or "" so the unique index below also covers brand-level charts
  gender       Gender   @default(UNISEX)
  region       String   @default("GLOBAL") // sizing system / market: IN, GLOBAL, ASIA, US, EU, UK...
  productLine  String   @default("")       // e.g. "Tops & Tees (alpha)"; empty when the brand has one chart
  fitCut       String   @default("REGULAR") // the GARMENT's cut as sold (SLIM|REGULAR|RELAXED|OVERSIZED|UNKNOWN). UNKNOWN = the source does not say.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  versions     BrandSizeChartVersion[]
  @@unique([brandId, categoryId, productKey, gender, region, productLine, fitCut], map: "BrandSizeChart_identity_key")
}

// Rows: [{ "label": "M", "chestCm": 102, "waistCm": 96, ... }]  — these are GARMENT measurements.
model BrandSizeChartVersion {
  id             String   @id @default(cuid())
  chartId        String
  chart          BrandSizeChart @relation(fields: [chartId], references: [id], onDelete: Cascade)
  version        Int
  rows           Json
  // GARMENT | BODY | UNKNOWN: what the published numbers describe. UNKNOWN is never silently treated as GARMENT;
  // per-dimension meaning lives in measurementSemantics and wins over this chart-level default.
  measurementType String  @default("GARMENT")
  sourceType     SourceType @default(MANUAL_ENTRY)
  originalUnit   Unit     @default(CM)        // unit the source used; rows are always stored in cm
  retrievedAt    DateTime?
  sourceDomain   String?
  extractionMethod String?
  // What each column means, e.g. {"chest":"BODY_CIRCUMFERENCE"}. Unknown meaning = "AMBIGUOUS".
  measurementSemantics Json @default("{}")
  // Dimensions whose meaning is unclear. They are ignored by the recommendation engine until a human resolves them.
  ambiguousDimensions  Json @default("[]")
  verifications  DataVerification[]
  status         VerificationStatus @default(UNVERIFIED)
  sourceUrl      String?
  sourceNote     String?
  verifiedAt     DateTime?
  verifiedById   String?
  verifiedBy     User?    @relation("VersionVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  recommendations Recommendation[]
  researchSources ResearchSource[]
  @@unique([chartId, version])
}

model Recommendation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chartVersionId String
  chartVersion BrandSizeChartVersion @relation(fields: [chartVersionId], references: [id])
  fitPreference FitPreference
  recommendedSize String?
  confidence  Float?
  insufficientData Boolean @default(false)
  result      Json     // full structured engine output
  inputSnapshot Json   // body measurements used (cm) at the time
  createdAt   DateTime @default(now())
  feedback    UserFitFeedback[]
  @@index([userId, createdAt])
}

model SavedBrand {
  userId  String
  brandId String
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand   Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, brandId])
}

model UserFitFeedback {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendationId String
  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  purchasedSize  String
  outcome        FitOutcome
  review         String?
  createdAt      DateTime @default(now())
  @@index([recommendationId])
  @@map("UserFeedback") // table name kept so existing data is untouched
}

// Records that a brand/category/gender (or one product, when productId is set) was checked and no usable data exists.
// productId null = missing BRAND-level data; productId set = missing PRODUCT-level data.
model BrandCoverageNote {
  id         String   @id @default(cuid())
  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceUrl  String?
  categoryId String?
  gender     Gender?
  note       String
  checkedAt  DateTime @default(now())
  @@index([brandId])
}

model Marketplace {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  domain    String   @unique
  active    Boolean  @default(true)
  listings  ProductListing[]
}

// A real product with its real brand identity. Marketplaces never own products.
model Product {
  id          String   @id @default(cuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  categoryId  String
  category    ClothingCategory @relation(fields: [categoryId], references: [id])
  gender      Gender   @default(UNISEX)
  fitCut      String   @default("REGULAR") // UNKNOWN when the listing does not state the cut
  coverageNotes BrandCoverageNote[]
  fitCutStated Boolean @default(false) // did the listing actually state the cut?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  listings    ProductListing[]
  charts      BrandSizeChart[]
  @@unique([brandId, slug])
}

model ProductListing {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketplaceId String?  // null = the brand's own site
  marketplace   Marketplace? @relation(fields: [marketplaceId], references: [id], onDelete: SetNull)
  url           String   @unique
  retrievedAt   DateTime?
  active        Boolean  @default(true)
}

// Reference table: what a published measurement actually represents.
model MeasurementDefinition {
  id          String @id @default(cuid())
  code        String @unique // e.g. BODY_CIRCUMFERENCE, GARMENT_CIRCUMFERENCE, GARMENT_WIDTH_FLAT, GARMENT_LENGTH, AMBIGUOUS
  name        String
  appliesTo   String // BODY | GARMENT | UNKNOWN
  description String
}

model ResearchJob {
  id          String   @id @default(cuid())
  state       JobState @default(QUEUED)
  targets     Json
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  summary     Json?
  createdAt   DateTime @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  sources     ResearchSource[]
}

model ResearchSource {
  id               String   @id @default(cuid())
  jobId            String?
  job              ResearchJob? @relation(fields: [jobId], references: [id], onDelete: Cascade)
  url              String
  domain           String
  status           ResearchStatus
  httpStatus       Int?
  extractionMethod String?
  note             String?
  chartVersionId   String?
  chartVersion     BrandSizeChartVersion? @relation(fields: [chartVersionId], references: [id], onDelete: SetNull)
  retrievedAt      DateTime @default(now())
  @@index([jobId])
  @@index([url])
}

// Audit trail of every human decision about a chart version.
model DataVerification {
  id             String   @id @default(cuid())
  chartVersionId String
  chartVersion   BrandSizeChartVersion @relation(fields: [chartVersionId], references: [id], onDelete: Cascade)
  action         VerificationAction
  adminId        String?
  admin          User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  note           String?
  createdAt      DateTime @default(now())
  @@index([chartVersionId])
}

// ---------------------------------------------------------------- V5: identity & security

// Revocable server-side session. The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  lastSeenAt  DateTime  @default(now())
  revokedAt   DateTime?
  userAgent   String?   // truncated, for "your devices" in Settings
  ipHash      String?   // keyed hash, never the raw IP
  @@index([userId])
  @@index([expiresAt])
}

// Single-use, expiring email verification / password reset tokens. Only the SHA-256 hash is stored.
model AuthToken {
  id        String        @id @default(cuid())
  type      AuthTokenType
  tokenHash String        @unique
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String        // address the token was issued for (a later email change invalidates it)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  @@index([userId, type])
}

// Security events. Never contains passwords, tokens, measurements or raw IP addresses.
model AuthEvent {
  id        String        @id @default(cuid())
  type      AuthEventType
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipHash    String?
  userAgent String?
  createdAt DateTime      @default(now())
  @@index([type, createdAt])
  @@index([userId, createdAt])
}

// Audit history of administrative changes (brands, products, charts, research, users).
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String   // kept so the record stays readable if the admin account is later deleted
  action     String   // e.g. brand.create, chart.approve, user.role.change
  targetType String
  targetId   String?
  details    Json     @default("{}")
  createdAt  DateTime @default(now())
  @@index([createdAt])
  @@index([targetType, targetId])
}
