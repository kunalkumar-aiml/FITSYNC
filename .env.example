# Copy to .env for local development. NEVER commit .env. See docs/DEPLOYMENT.md for what each value does.

# ---- Required
# PostgreSQL connection string (Neon / Supabase / Vercel Postgres, or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fitsync?sslmode=require"
# Random secret, at least 32 characters (keyed hashes of IPs in security logs). Generate: openssl rand -base64 48
AUTH_SECRET=""
# Public origin of the site, used in email links and as the allowed Origin for CSRF checks
APP_URL="http://localhost:3000"

# ---- Email (verification + password reset). Without it, emails are NOT sent and the UI says so.
# Development falls back to printing emails in the server console.
RESEND_API_KEY=""
EMAIL_FROM="FITSYNC <no-reply@your-verified-domain.example>"
# EMAIL_PROVIDER="resend"   # optional: resend | console (dev only) | outbox (automated tests only)

# ---- Rate limiting shared across serverless instances (strongly recommended in production)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---- Retention job (Vercel cron calls /api/cron/cleanup with this bearer secret). At least 16 characters.
CRON_SECRET=""

# ---- Client IP for rate limits: only trust proxy headers behind a proxy that overwrites them.
# Vercel is detected automatically. Set TRUST_PROXY=true only behind your own trusted reverse proxy.
# TRUST_PROXY="true"

# ---- Optional: source discovery for the research pipeline (a permitted search API)
# SEARCH_PROVIDER="brave"          # brave | google
# BRAVE_SEARCH_API_KEY=""
# GOOGLE_CSE_API_KEY=""
# GOOGLE_CSE_ID=""

# ---- Local only
# COOKIE_SECURE="false"            # lets `npm start` work over plain http on your machine
# SHOW_DEMO_BRANDS="true"          # show the sample brands outside development
# SEED_DEMO="true"                 # create the sample brands when seeding

# ---- One-time administrator bootstrap (CLI only; unset afterwards). ADMIN_EMAILS no longer exists.
# ADMIN_BOOTSTRAP_PASSWORD=""
