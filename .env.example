# Copy to .env for local development. NEVER commit .env.
# PostgreSQL connection string (Neon / Supabase / Vercel Postgres, or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fitsync?sslmode=require"

# Random secret, min 32 chars. Generate:  openssl rand -base64 48
AUTH_SECRET=""

# Comma-separated emails that become ADMIN when they register/log in
ADMIN_EMAILS="you@example.com"
